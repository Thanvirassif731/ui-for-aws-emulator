{
  "name": "aws-emulator-ui",
  "private": true,
  "version": "0.5.0",
  "description": "S3 Learning Sandbox with static website hosting, policy simulator, versioning visualizer, and lifecycle time-travel.",
  "type": "module",
  "contributors": [
    "Thanvir Assif"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "aws4": "^1.13.2",
    "dockerode": "^5.0.1",
    "express": "^4.21.2",
    "mime-types": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
